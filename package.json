{
  "name": "cqut-auth",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vp run build:ui && vp run build:server",
    "build:server": "vp exec tsc -p tsconfig.build.json",
    "build:ui": "vp build --config web/vite.config.ts",
    "check": "vp check && vp run check:env-source",
    "check:env-source": "node scripts/check-single-env-source.mjs",
    "dev": "concurrently -k \"vp run dev:server\" \"vp run dev:ui\"",
    "dev:server": "vp exec tsx watch --env-file=deploy/.env src/main.ts",
    "dev:ui": "vp build --watch --config web/vite.config.ts",
    "dev:oidc": "vp exec tsx watch --env-file=deploy/.env src/main.ts",
    "docker:build": "docker build -t cqut-auth-oidc .",
    "docker:up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f deploy/docker-compose.yml down",
    "docker:up:prod-small": "docker compose -f deploy/docker-compose.prod-small.yml up -d --build",
    "init-env": "node scripts/init-env.mjs",
    "init-env:stdout": "node scripts/init-env.mjs --stdout",
    "lint": "vp lint && vp run check:env-source",
    "test": "vp test",
    "test:server": "vp test --project server",
    "test:ui": "vp test --project web",
    "seed:client": "vp exec tsx src/scripts/seed-oidc-client.ts",
    "seed:key": "vp exec tsx src/scripts/seed-oidc-signing-key.ts",
    "docs:dev": "vp run --filter cqut-auth-docs dev",
    "docs:build": "vp run --filter cqut-auth-docs build",
    "docs:preview": "vp run --filter cqut-auth-docs preview",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "verify": "vp run check && vp test && vp run build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@cqut-openproject/cas-sdk": "github:CQUT-OpenProject/CAS-SDK#v2.0.0",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@tanstack/react-query": "^5.101.2",
    "antd": "^5.29.3",
    "axios": "^1.18.1",
    "dayjs": "^1.11.23",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "jose": "^6.2.2",
    "nodemailer": "^9.1.1",
    "oidc-provider": "^9.7.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.3.0",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jsdom": "^27.0.0",
    "supertest": "^7.1.4",
    "tsx": "4.20.6",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
